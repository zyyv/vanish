{
  "name": "@zyyv/vanish",
  "version": "0.1.0",
  "description": "A reversible WebGL particle disintegration effect for Vue 3.",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "keywords": [
    "vue",
    "webgl",
    "animation",
    "particle",
    "disintegration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyyv/vanish.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^7.1.7",
    "vue": "^3.5.21",
    "vue-tsc": "^3.0.8"
  }
}
