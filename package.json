{
  "name": "vanish-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @zyyv/vanish build && pnpm --parallel --filter @zyyv/vanish --filter playground run dev",
    "build": "pnpm --filter @zyyv/vanish build && pnpm --filter playground build",
    "typecheck": "pnpm -r typecheck",
    "pack:vanish": "pnpm --filter @zyyv/vanish pack"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.8"
  },
  "packageManager": "pnpm@11.4.0"
}
