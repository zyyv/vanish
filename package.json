{
  "name": "vanish-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -C packages/vanish run dev",
    "build": "pnpm -r run build",
    "play": "pnpm -C playground run dev",
    "deploy:playground": "pnpm -C playground run build && wrangler deploy",
    "release": "bumpp -r --execute=\"pnpm i\"",
    "typecheck": "pnpm -C packages/vanish run typecheck"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "bumpp": "^12.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8",
    "wrangler": "^4.114.0"
  },
  "packageManager": "pnpm@11.17.0"
}
